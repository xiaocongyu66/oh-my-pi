{
	"name": "@oh-my-pi/pi-i18n",
	"version": "18.8.9",
	"description": "Natural-key i18n engine: t('English text') with flat locale packs",
	"keywords": [
		"i18n",
		"localization",
		"translation"
	],
	"homepage": "https://omp.sh",
	"bugs": {
		"url": "https://github.com/can1357/oh-my-pi/issues"
	},
	"license": "MIT",
	"author": { "name": "Stencil Labs, Inc.", "url": "https://stencil.so" },
	"repository": {
		"type": "git",
		"url": "git+https://github.com/can1357/oh-my-pi.git",
		"directory": "packages/i18n"
	},
	"files": [
		"src",
		"locales",
		"README.md"
	],
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		},
		"./*": {
			"types": "./src/*.ts",
			"import": "./src/*.ts"
		},
		"./*.js": "./src/*.ts"
	},
	"scripts": {
		"check": "oxlint . && oxfmt --check --no-error-on-unmatched-pattern 'src/**/*.ts' 'test/**/*.ts' && bun run check:types",
		"check:types": "tsgo -p tsconfig.json --noEmit",
		"lint": "oxlint .",
		"test": "bun test --parallel",
		"fix": "oxlint --fix --fix-suggestions . && bun run fmt",
		"fmt": "oxfmt --no-error-on-unmatched-pattern 'src/**/*.ts' 'test/**/*.ts'"
	},
	"devDependencies": {
		"@types/bun": "catalog:"
	},
	"engines": {
		"bun": ">=1.3.14"
	}
}
